# Multi-stage build for megacommerce-web monorepo
# Serves as a base Dockerfile for the entire monorepo
FROM node:23-alpine AS base

WORKDIR /app

ENV ENV=dev \
    NODE_ENV=development

# Install build tools
RUN apk add --no-cache python3 make g++ curl bash

# Install pnpm
RUN npm install -g pnpm@10.10.0

# Dependencies stage
FROM base AS deps

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
RUN pnpm install --frozen-lockfile

# Build shared packages (required for apps to compile)
FROM deps AS build-deps

WORKDIR /app
RUN pnpm nx run shared:build || true

# Development stage
FROM base AS dev

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build-deps /app/packages/shared/dist ./packages/shared/dist

# Copy all app config and translations directories
COPY apps/customer-app/config ./apps/customer-app/config
COPY apps/customer-app/translations ./apps/customer-app/translations
COPY apps/home-app/config ./apps/home-app/config
COPY apps/home-app/translations ./apps/home-app/translations
COPY apps/supplier-app/config ./apps/supplier-app/config
COPY apps/supplier-app/translations ./apps/supplier-app/translations
COPY apps/shared-api/config ./apps/shared-api/config
COPY apps/shared-api/translations ./apps/shared-api/translations

# Default to home-app, can be overridden
ENV APP_NAME=home-app

EXPOSE 3000

CMD ["sh", "-c", "pnpm nx run ${APP_NAME}:dev"]
