FROM node:23-alpine AS base
WORKDIR /app
ENV NODE_ENV=development
RUN apk add --no-cache python3 make g++ curl bash
RUN npm install -g pnpm@10.10.0

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps/supplier-app ./apps/supplier-app
COPY packages ./packages
RUN pnpm install --frozen-lockfile --prefer-offline

FROM deps AS build-shared
WORKDIR /app
RUN pnpm nx run shared:build

FROM base AS prod-deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps/supplier-app ./apps/supplier-app
COPY packages ./packages
RUN pnpm install --frozen-lockfile --prod --prefer-offline
# Remove unused nest dependencies for Next.js frontend
RUN pnpm remove --prod \
    @fastify/cookie \
    @nestjs/common \
    @nestjs/config \
    @nestjs/core \
    @nestjs/platform-express \
    @nestjs/platform-fastify \
    fastify \
    2>/dev/null || true

FROM base AS dev
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=prod-deps /app/apps/supplier-app ./apps/supplier-app
COPY --from=prod-deps /app/packages ./packages
COPY --from=build-shared /app/dist/packages/shared ./packages/shared/dist

# Copy runtime config and translations
COPY apps/supplier-app/config ./apps/supplier-app/config
COPY apps/supplier-app/translations ./apps/supplier-app/translations

EXPOSE 3002
CMD ["pnpm", "nx", "run", "supplier-app:dev"]
