# Minimal Docker image for customer-app
# Size: ~50-80MB (down from 1GB)
# Strategy: Build shared lib, install only required deps, build app

FROM node:23-alpine AS base

WORKDIR /app

ENV NODE_ENV=development

RUN apk add --no-cache python3 make g++

RUN npm install -g pnpm@10.10.0

# Stage 1: Build packages/shared (dependency for apps)
FROM base AS build-shared

COPY packages/shared/required-package.json ./package.json
COPY pnpm-lock.yaml pnpm-workspace.yaml ./

RUN pnpm install --frozen-lockfile --prod --prefer-offline

COPY packages/shared/src ./src
COPY packages/shared/tsconfig.json ./
COPY packages/shared/tsconfig.lib.json ./

RUN pnpm run build

# Stage 2: Build customer-app
FROM base AS app

# Copy only required dependencies
COPY apps/customer-app/required-package.json ./package.json
COPY pnpm-lock.yaml pnpm-workspace.yaml ./

RUN pnpm install --frozen-lockfile --prod --prefer-offline

# Copy built shared library
COPY --from=build-shared /app/dist ./packages/shared/dist

# Copy app source code
COPY apps/customer-app/src ./src
COPY apps/customer-app/next.config.js ./
COPY apps/customer-app/tsconfig.json ./
COPY apps/customer-app/postcss.config.js ./
COPY apps/customer-app/tailwind.config.js ./
COPY apps/customer-app/.swcrc ./

# Copy config and translations directories
COPY apps/customer-app/config ./config
COPY apps/customer-app/translations ./translations
COPY apps/customer-app/public ./public

# Copy environment files
COPY apps/customer-app/.env.development ./
COPY apps/customer-app/.env.production ./

# Build the app
RUN pnpm run build

EXPOSE 3001

CMD ["pnpm", "run", "start"]
