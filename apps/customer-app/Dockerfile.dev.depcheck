# Optimized multi-stage build for customer-app WITH depcheck analysis
# Build context: megacommerce-web root
# Use this instead of Dockerfile.dev if you want dependency analysis during build
# Note: depcheck can have false positives, use with caution

FROM node:23-alpine AS base
WORKDIR /app
ENV NODE_ENV=development
RUN apk add --no-cache python3 make g++ curl bash
RUN npm install -g pnpm@10.10.0

# Stage 1: Install all dependencies for building
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps/customer-app ./apps/customer-app
COPY packages ./packages
RUN pnpm install --frozen-lockfile --prefer-offline

# Stage 2: Build shared library (dependency for apps)
FROM deps AS build-shared
WORKDIR /app
RUN pnpm nx run shared:build

# Stage 3: Analyze dependencies with depcheck
FROM deps AS analyze
WORKDIR /app
RUN npm install -g depcheck
# Run depcheck to identify unused dependencies
# This generates a report but doesn't fail the build (useful for analysis)
RUN depcheck apps/customer-app --ignores="@megacommerce/*,@mantine/*,@radix-ui/*,@tabler/*,@uppy/*,@nestjs/*" || true

# Stage 4: Deploy minimal production dependencies
FROM base AS prod-deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps/customer-app ./apps/customer-app
COPY packages ./packages
RUN pnpm install --frozen-lockfile --prefer-offline
# Deploy to a clean directory with minimal deps (only prod, no devDeps)
RUN pnpm deploy --prod --filter=root ./prod-deployment

# Stage 5: Final runtime image (minimal)
FROM base AS dev
# Copy deployed minimal node_modules
COPY --from=prod-deps /app/prod-deployment/node_modules ./node_modules
# Copy source code
COPY --from=prod-deps /app/apps/customer-app ./apps/customer-app
COPY --from=prod-deps /app/packages ./packages
# Copy pre-built shared library dist
COPY --from=build-shared /app/packages/shared/dist ./packages/shared/dist

# Copy runtime config and translations
COPY apps/customer-app/config ./apps/customer-app/config
COPY apps/customer-app/translations ./apps/customer-app/translations

EXPOSE 3001
CMD ["pnpm", "nx", "run", "customer-app:dev"]
