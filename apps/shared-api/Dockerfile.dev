# Minimal Docker image for shared-api (NestJS)
# Size: ~30-50MB (down from 1GB)
# Strategy: Build shared lib, install only required deps, build app

FROM node:23-alpine AS base

WORKDIR /app

ENV NODE_ENV=development

RUN apk add --no-cache python3 make g++

RUN npm install -g pnpm@10.10.0

# Stage 1: Build packages/shared (dependency for apps)
FROM base AS build-shared

COPY packages/shared/required-package.json ./package.json
COPY pnpm-lock.yaml pnpm-workspace.yaml ./

RUN pnpm install --frozen-lockfile --prod --prefer-offline

COPY packages/shared/src ./src
COPY packages/shared/tsconfig.json ./
COPY packages/shared/tsconfig.lib.json ./

RUN pnpm run build

# Stage 2: Build shared-api
FROM base AS app

# Copy only required dependencies
COPY apps/shared-api/required-package.json ./package.json
COPY pnpm-lock.yaml pnpm-workspace.yaml ./

RUN pnpm install --frozen-lockfile --prod --prefer-offline

# Copy built shared library
COPY --from=build-shared /app/dist ./packages/shared/dist

# Copy app source code
COPY apps/shared-api/src ./src
COPY apps/shared-api/tsconfig.json ./
COPY apps/shared-api/.swcrc ./

# Copy config and translations directories
COPY apps/shared-api/config ./config
COPY apps/shared-api/translations ./translations

# Copy environment files
COPY apps/shared-api/.env.development ./
COPY apps/shared-api/.env.production ./

# Build the app
RUN pnpm run build

EXPOSE 3003

CMD ["pnpm", "run", "start"]
