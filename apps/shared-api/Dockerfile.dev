# Optimized multi-stage build for shared-api (NestJS backend)
# Build context: megacommerce-web root
# Key: Only final 'dev' stage is pushed to registry, intermediate layers are build-cache only

FROM node:23-alpine AS base
WORKDIR /app
ENV NODE_ENV=development
RUN apk add --no-cache python3 make g++ curl bash
RUN npm install -g pnpm@10.10.0

# Stage 1: Full install for building (build-cache only, ~1.5GB layer, not pushed)
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps/shared-api ./apps/shared-api
COPY packages ./packages
RUN pnpm install --frozen-lockfile --prefer-offline

# Stage 2: Build shared library
FROM deps AS build-shared
WORKDIR /app
RUN pnpm nx run shared:build

# Stage 3: MINIMAL layer - production dependencies only
# Use --prod flag to ONLY install production deps, avoiding devDependencies entirely
FROM base AS prod-deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps/shared-api ./apps/shared-api
COPY packages ./packages
# Key: --prod flag means devDependencies are NOT installed
RUN pnpm install --frozen-lockfile --prod --prefer-offline

# Stage 4: Final runtime image (~300-400MB, this is what gets pushed)
FROM base AS dev
# Copy only production node_modules from prod-deps stage
COPY --from=prod-deps /app/node_modules ./node_modules
# Copy source code
COPY --from=prod-deps /app/apps/shared-api ./apps/shared-api
COPY --from=prod-deps /app/packages ./packages
# Copy pre-built shared library dist
COPY --from=build-shared /app/dist/packages/shared ./packages/shared/dist

# Copy runtime config and translations
COPY apps/shared-api/config ./apps/shared-api/config
COPY apps/shared-api/translations ./apps/shared-api/translations

EXPOSE 3003
CMD ["pnpm", "nx", "run", "shared-api:dev"]
